{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/build\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\n\\s*TAG:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+.*)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["simulot/immich-go"],
      "matchDatasources": ["github-releases"],
      "automerge": true,
      "allowedVersions": "< 1.0.0"
    }
  ]

}
